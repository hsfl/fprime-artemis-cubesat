<mxfile host="app.diagrams.net"><diagram name="05_layers" id="05_layers"><mxGraphModel page="1" pageWidth="1200" pageHeight="720"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Application - Manager - Driver" style="rounded=1;whiteSpace=wrap;html=0;fillColor=white;strokeColor=none;fontColor=#202a33;fontFamily=Arial;fontSize=28;fontStyle=1;spacing=10;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="12" width="1140" height="40" as="geometry"/></mxCell><mxCell id="subtitle" value="Three layers. Protocol knowledge belongs in the manager; the driver owns the hardware interface." style="rounded=1;whiteSpace=wrap;html=0;fillColor=white;strokeColor=none;fontColor=#202a33;fontFamily=Arial;fontSize=18;fontStyle=0;spacing=10;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="57" width="1140" height="30" as="geometry"/></mxCell><mxCell id="hAPPLICATION" value="APPLICATION" style="rounded=1;whiteSpace=wrap;html=0;fillColor=white;strokeColor=none;fontColor=#202a33;fontFamily=Arial;fontSize=23;fontStyle=1;spacing=10;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="35" y="115" width="320" height="40" as="geometry"/></mxCell><mxCell id="hMANAGER" value="MANAGER" style="rounded=1;whiteSpace=wrap;html=0;fillColor=white;strokeColor=none;fontColor=#202a33;fontFamily=Arial;fontSize=23;fontStyle=1;spacing=10;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="440" y="115" width="320" height="40" as="geometry"/></mxCell><mxCell id="hDRIVER" value="DRIVER" style="rounded=1;whiteSpace=wrap;html=0;fillColor=white;strokeColor=none;fontColor=#202a33;fontFamily=Arial;fontSize=23;fontStyle=1;spacing=10;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="845" y="115" width="320" height="40" as="geometry"/></mxCell><mxCell id="app" value="MissionApp&#xa;Request payload or Pi power" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e9f4eb;strokeColor=#477a5