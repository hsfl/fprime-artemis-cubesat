flowchart LR
  classDef host fill:#eef7ff,stroke:#246,stroke-width:1px,color:#111;
  classDef fw fill:#f7f7f7,stroke:#444,stroke-width:1px,color:#111;
  classDef link fill:#fff6e6,stroke:#8a5a00,stroke-width:1px,color:#111;
  classDef tool fill:#ecfff2,stroke:#14532d,stroke-width:1px,color:#111;
  classDef subsystem fill:#fff2f2,stroke:#7f1d1d,stroke-width:1px,color:#111;

  subgraph RPI["Raspberry Pi (Flight Computer)"]
    FSW["ArtemisRpiTeensy_N2 F' Deployment (ArtemisRpiTeensyDeployment)"]:::fw
    LINUXUART["Drv.LinuxUartDriver /dev/serial0"]:::fw
    APP["Custom Components TeensyLink, PingResponder"]:::fw
    FSW --> APP
    FSW --> LINUXUART
  end
  class RPI host;

  subgraph SAT["Satellite Teensy (Baremetal)"]
    SATFW["ArtemisTeensy_N2_Baremetal satellite_teensy.ino"]:::fw
    SATUART["UART Wrapper 0xD4 0xC3 + len + crc16"]:::link
    SATRF["RF23BP Segmenter/Reassembler msg_id/seg_idx/seg_count"]:::link
    PDU["PDU Subsystem"]:::subsystem
    TEMP["Temp Sensors"]:::subsystem
    IMU["IMU"]:::subsystem
    GPS["GPS"]:::subsystem
    SATFW --> SATUART
    SATFW --> SATRF
    SATFW --> PDU
    SATFW --> TEMP
    SATFW --> IMU
    SATFW --> GPS
  end
  class SAT host;

  subgraph GRD["Ground Teensy (RF/USB)"]
    GRDFW["GDS_Teensy gds_teensy.ino"]:::fw
    GRDRF["RF23BP Reassembly + Segmentation"]:::link
    GRDUSB["USB Serial Bridge Raw F' bytes / burst uplink"]:::link
    GRDFW --> GRDRF
    GRDFW --> GRDUSB
  end
  class GRD host;

  subgraph OPS["Operator Laptop"]
    GDS["fprime-gds UART mode"]:::tool
  end
  class OPS host;

  subgraph N1_PAYLOAD["N1_Payload"]
    N1USB["Payload Interface"]:::link
  end
  class N1_PAYLOAD host;

  N1USB -->|"USB RS22"| FSW

  LINUXUART <-->|"Custom UART Frame Protocol"| SATUART
  SATRF <-->|"RF segmented transport"| GRDRF
  GRDUSB <-->|"USB serial"| GDS
