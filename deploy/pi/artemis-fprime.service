# N2 CDR TCP profile. Install supervisor as /home/n2-obc/artemis/artemis-supervisor.py.
[Unit]
Description=Neutron-2 CDR TCP F Prime
After=local-fs.target systemd-udev-trigger.service
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=notify
NotifyAccess=main
User=n2-obc
Group=n2-obc
SupplementaryGroups=dialout
WorkingDirectory=/home/n2-obc/artemis/state
Environment=N2_STORAGE_ROOT=/home/n2-obc/artemis/data/science-products
ExecStart=/usr/bin/python3 /home/n2-obc/artemis/artemis-supervisor.py --uart /dev/serial0 --tcp-port 50000 -- /home/n2-obc/artemis/current/ArtemisRpiTeensyDeployment -a 0.0.0.0 -p 50000 -d /dev/serial0
# UART can appear arbitrarily late; readiness requires fresh EPS progress and the child TCP listener.
TimeoutStartSec=infinity
WatchdogSec=45
Restart=on-failure
RestartSec=2
TimeoutStopSec=10
KillSignal=SIGTERM
NoNewPrivileges=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=artemis-fprime

[Install]
WantedBy=multi-user.target
