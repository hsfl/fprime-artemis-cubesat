# Neutron 2 F Prime Raspberry Pi service.
# Install on the Pi as /etc/systemd/system/artemis-fprime.service.
# The binary and dictionary are managed as symlinks under /home/pi/artemis/current
# so a new release can be installed without changing this unit file.

[Unit]
Description=Artemis C3M F Prime deployment
# Wait for local filesystems so /home/pi/artemis/current exists before launch.
After=local-fs.target
# The deployment talks to the satellite Teensy over /dev/serial0, so do not
# block flight-software startup on Wi-Fi or network-online timing.
# Fail clearly if the release symlink has not been installed yet.
ConditionPathExists=/home/pi/artemis/current/ArtemisRpiTeensyDeployment

[Service]
Type=simple
# Current bench Pi docs use the default Raspberry Pi account.
User=pi
Group=pi
# Keep relative paths, future dictionary references, and generated files anchored
# next to the current release binary and dictionary symlinks.
WorkingDirectory=/home/pi/artemis/current
# C3M camera HIL policy. Each payload driver consumes its own explicit backend
# setting; keeping both here preserves the existing Lepton default while making
# Boson use the stable udev device path on the Pi.
Environment=LEPTON_CAMERA_BACKEND=uvc
Environment=BOSON_CAMERA_BACKEND=v4l2
Environment=BOSON_V4L2_DEVICE=/dev/v4l/by-id/usb-FLIR_Boson_371025-video-index0
# /dev/serial0 is the Pi-to-satellite-Teensy UART used by the Artemis OBC bench.
ExecStart=/home/pi/artemis/current/ArtemisRpiTeensyDeployment -d /dev/serial0
# Demo hardening: bring the flight app back if it crashes or exits unexpectedly.
Restart=always
RestartSec=5
# Send stdout/stderr to journald so students can use journalctl for triage.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=artemis-fprime

[Install]
WantedBy=multi-user.target
